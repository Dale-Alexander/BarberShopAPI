STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
JWT_SECRET=
DefaultConnection=
RESEND_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The seed (--seed-admin) is keyed on ADMIN_EMAIL, so for more than one admin, run it once per
# person with that person's values. Re-running with the SAME email just updates that account and
# is safe to repeat. NOTE: changing ADMIN_EMAIL does not rename an existing admin - it creates an
# ADDITIONAL one, and the old account keeps working on its old password. The seed says so loudly
# when that happens.
#
# Set ADMIN_IS_BARBER=true when the shop owner also cuts hair, so the seed gives their admin
# account a barber profile and customers can book them. ADMIN_NAME is then required - it is the
# name customers see on the booking page. Leave ADMIN_IS_BARBER unset/false for a manager who
# doesn't take appointments; the flag is read per run, so an owner who cuts hair and a manager who
# doesn't can coexist. The seed only ever ADDS the barber profile: setting this back to false
# later does not remove it (use the Accepting Bookings toggle on the Team page instead).
ADMIN_NAME=
ADMIN_IS_BARBER=
FRONTEND_BASE_URL=http://localhost:5173

//used as a template holder so those in git can see what .env actually looks like
