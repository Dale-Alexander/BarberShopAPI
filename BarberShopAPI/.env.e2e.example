# Template for .env.e2e - copy to .env.e2e and fill in. The real file is gitignored.
#
# The browser tests point the API at this file via BARBERSHOP_ENV_FILE, because DotNetEnv overwrites
# variables already in the environment and would otherwise replace anything set on the command line
# with the values from .env - silently running the tests against the development database.
#
# The database name MUST contain "E2E". --seed-e2e deletes every row and refuses to run against a
# database that isn't named as a test one.
DefaultConnection=Server=YOUR_SERVER\SQLEXPRESS;Database=BarberShop_E2E;Trusted_Connection=True;TrustServerCertificate=True

# Any value - the tests sign in with these, and the seed gives the fixture barbers the same password.
# Nothing here unlocks anything real, but keep it distinct from your development credentials.
ADMIN_EMAIL=admin@e2e.test
ADMIN_PASSWORD=
ADMIN_NAME=E2E Admin
ADMIN_IS_BARBER=false

# Any non-empty string. Tokens are only ever verified by this same process.
JWT_SECRET=

# Stripe TEST-mode keys (pk_test_/sk_test_). Needed because the checkout page renders a real Stripe
# card element; the test card 4242 4242 4242 4242 completes a payment without money moving.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# The Stripe CLI's OWN webhook signing secret - not the one from the Dashboard. The card specs run
# `stripe listen`, which signs with this, and the API verifies every delivery against it. Get it with:
#
#     stripe listen --print-secret
#
# It is stable per account + machine, so this is a one-time step. Wrong or missing and the card specs
# skip with an explanation rather than failing somewhere unrecognisable.
STRIPE_WEBHOOK_SECRET=

# Any non-empty string. The browser tests never reach the real Resend - RESEND_API_URL below points the
# client at the harness's local sink - but the client still wants a token for the Bearer header.
RESEND_API_KEY=re_e2e_not_a_real_key

# Sends every email to the harness's mail sink (BarberShop/e2e/sink-server.js) instead of Resend, so
# specs can assert on what the customer was actually sent. UNSET THIS ANYWHERE REAL - with no value the
# client keeps its own https://api.resend.com default, which is what production and development use.
RESEND_API_URL=http://localhost:5299

FRONTEND_BASE_URL=http://localhost:5173
