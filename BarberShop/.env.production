# =====================================================================
# PRODUCTION build config. Used ONLY by `vite build`, never by
# `vite dev` (dev keeps using .env). Vite bakes these values into the
# compiled JS at BUILD time, so you must rebuild after changing them.
#
# NOTE: Vite MERGES .env and .env.production (production wins on
# overlaps). Any key you leave out here falls back to .env -- which is
# why the Stripe LIVE key must be listed below, or the build would
# silently fall back to the TEST key from .env.
# =====================================================================

# Your backend's public URL -- used to build barber image URLs.
# With the Shape 1 rewrite, this can be the raw host, e.g.
#   https://barbershop-api.azurewebsites.net
# Replace before deploying:
VITE_BASE_URL=https://YOUR-BACKEND-URL

# Stripe LIVE publishable key (pk_live_...). Reveal it by turning off
# test mode in the Stripe dashboard. Do NOT ship the pk_test_ key.
# Replace before deploying:
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
